# ============================================================
# .gitattributes — limitbreaker9/fpga_projects
# Surfaces hand-written Verilog/VHDL/SystemVerilog/constraints
# by excluding Xilinx-generated BSP code, build artifacts, and
# vendored third-party IP from GitHub's language stats.
# ============================================================

# ---- Force correct detection of real, hand-written source ----
*.v      linguist-language=Verilog
*.sv     linguist-language=SystemVerilog
*.vhd    linguist-language=VHDL
*.vhdl   linguist-language=VHDL
*.xdc    linguist-language=Tcl
*.tcl    linguist-language=Tcl

# ---- Xilinx-generated Board Support Package (BSP) / drivers ----
# Auto-generated by Vitis every time a platform is built — not hand-written
**/ps7_cortexa9_0/**          linguist-generated
**/standalone*_cortexa9_0/**  linguist-generated
**/bsp/libsrc/**              linguist-generated
**/bsp/lib/**                 linguist-generated

# ---- First Stage Bootloader — Xilinx boilerplate ----
**/zynq_fsbl/**  linguist-generated

# ---- Vivado/Vitis hardware export + synthesis/impl reports ----
**/hw/sdt/**  linguist-generated

# ---- Third-party vendored IP (Digilent vivado-library) ----
**/vivado-library-master/**  linguist-vendored

# ---- Build system noise (CMake/Ninja/compile db) ----
**/CMakeFiles/**       linguist-generated
CMakeCache.txt         linguist-generated
*.cmake                linguist-generated
*.ninja                linguist-generated
compile_commands.json  linguist-generated
**/.cache/**           linguist-vendored

# ---- Treat binaries as binary (no diffs, not counted anyway) ----
*.bit  binary
*.xsa  binary
*.elf  binary
*.dcp  binary
*.a    binary
*.obj  binary
